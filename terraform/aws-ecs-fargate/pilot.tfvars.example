# One file and one remote-state key per organization. Replace every example
# domain/account value; never share this stack's state or credentials.
pilot_profile = true
name          = "geolens-org-slug"
region        = "us-east-1"
geolens_version = "1.20.0"

# The ACM certificate must be ISSUED in this region and cover this hostname.
public_app_url      = "https://maps.example.org"
acm_certificate_arn = "arn:aws:acm:us-east-1:111111111111:certificate/11111111-1111-1111-1111-111111111111"

# Per-organization resource and workload limits for the first pilot profile.
cache_enabled                 = false
app_desired_count             = 1
worker_concurrency            = 1
upload_max_size_mb            = 500
worker_ephemeral_storage_gb   = 50
db_instance_class             = "db.t4g.micro"
db_allocated_storage_gb       = 50

# Recovery and teardown controls. Keep these enabled through the pilot.
backup_retention_days                   = 14
skip_final_snapshot                     = false
deletion_protection                     = true
s3_versioning_enabled                   = true
s3_noncurrent_version_expiration_days   = 30
s3_force_destroy                        = false

# Optional provider credentials must be unique to this organization and stored
# under this deployment's Secrets Manager path. Configure provider-side spend
# limits separately; this recipe cannot enforce an AI provider budget.
# extra_secrets = {
#   ANTHROPIC_API_KEY = "arn:aws:secretsmanager:us-east-1:111111111111:secret:geolens-org-slug/ai-AbCdEf"
# }
