# Copy to terraform.tfvars and edit.

name   = "geolens"
region = "us-east-1"

# Pin the release you want. Bumping this re-runs migrations, then rolls the
# services.
geolens_version = "1.26.0"

# Leave empty to use the load balancer's DNS name over plain HTTP.
# Set both of these to serve a domain over HTTPS. Production data requires
# the stricter profile in production.tfvars.example instead of these trial defaults.
# public_app_url      = "https://geolens.example.com"
# acm_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/..."

# admin_username = "admin"
# admin_password = ""   # empty generates one into Secrets Manager

# cpu_architecture   = "ARM64"   # X86_64 where Graviton Fargate is unavailable
# app_desired_count  = 1
# app_autoscaling    = { min = 1, max = 3, cpu_target = 60 }   # size the database for max
# worker_desired_count = 1
# cache_enabled      = true
# upload_max_size_mb = 500
# worker_concurrency = 1
# db_instance_class  = "db.t4g.micro"
# db_high_availability = false   # true for a Multi-AZ standby, about twice the database cost
# db_max_allocated_storage_gb = 100
# container_insights = null    # "enhanced", "enabled" or "disabled"; null inherits the account setting
# app_task           = { cpu = 1024, memory = 3072 }
# worker_task        = { cpu = 1024, memory = 4096 }
# worker_ephemeral_storage_gb = 20

# Any other GeoLens setting. Plain values here, secrets by Secrets Manager ARN.
# extra_env = {
#   REGISTRATION_ENABLED = "true"
# }
# extra_secrets = {
#   OPENAI_API_KEY = "arn:aws:secretsmanager:us-east-1:111122223333:secret:geolens/ai-AbCdEf:OPENAI_API_KEY::"
# }
# Bump after rotating anything in extra_secrets so the services roll.
# extra_secrets_revision = "1"

# Teardown behaviour. Both default to false, the safe setting. Uncommenting
# either is a destructive opt-in: no final RDS snapshot, and a bucket deleted
# together with every object in it.
# skip_final_snapshot = true
# s3_force_destroy    = true
